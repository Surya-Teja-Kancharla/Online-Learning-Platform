# ==============================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control
# ==============================================

# ============== APPLICATION ==============
NODE_ENV=development
APP_NAME=OnlineLearningPlatform
PORT=5000
CLIENT_URL=http://localhost:3000

# ============== DATABASE ==============
DB_HOST=localhost
DB_PORT=5432
DB_NAME=learning_platform_db
DB_USER=postgres
DB_PASSWORD=your_secure_password
DATABASE_URL=postgresql://postgres:kst017@localhost:5432/Online_Learning_Platform

# ============== AUTHENTICATION ==============
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ============== FILE UPLOAD ==============
MAX_FILE_SIZE=50MB
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=video/mp4,application/pdf,image/jpeg,image/png

# ============== CLOUD STORAGE (Optional) ==============
# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=learning-platform-bucket

# Cloudinary (Alternative)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============== EMAIL SERVICE ==============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@learningplatform.com

# ============== RATE LIMITING ==============
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============== CORS ==============
CORS_ORIGIN=http://localhost:3000

# ============== LOGGING ==============
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# ============== REDIS (Optional - for caching) ==============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============== WEBRTC (Optional - for live classes) ==============
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_PASSWORD=

# ============== PAYMENT GATEWAY (Optional) ==============
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ============== ANALYTICS (Optional) ==============
GOOGLE_ANALYTICS_ID=
